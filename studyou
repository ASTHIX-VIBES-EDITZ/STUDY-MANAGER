    type: "Study",
    subject: selectedSubject || "",
  };
  formModal(
    id ? "Edit task" : "Plan a little progress",
    field(
      "Task title",
      "title",
      t.title,
      "text",
      true,
      'maxlength="180"',
      "full",
    ) +
      subjectField(t.subject) +
      selectField(
        "Chapter",
        "chapter",
        [
          ["", "No linked chapter"],
          ...state.chapters.filter(c=>c.subject===(t.subject||"")).map((c) => [c.id, c.name]),
        ],
        t.chapter,
      ) +
      field("Date", "date", t.date, "date", true) +
      selectField(
        "Priority",
        "priority",
        ["Low", "Medium", "High", "Urgent"],
        t.priority,
      ) +
      field("Start time", "start", t.start, "time") +
      field("End time", "end", t.end, "time") +
      selectField(
        "Task type",
        "type",
        [
          "Study",
          "Revision",
          "Homework",
          "Practice test",
          "Reading",
          "Project",
          "Personal",
        ],
        t.type,
      ) +
      selectField(
        "Status",
        "status",
        ["Pending", "In progress", "Completed", "Delayed", "Cancelled"],
        t.status,
      ) +
      textField("Notes", "notes", t.notes),
    async (d) => {
      if (!d.title.trim()) return "Give your task a title.";
      if(!validDate(d.date))return "Choose a valid task date.";
      if(Boolean(d.start)!==Boolean(d.end))return "Set both start and end times, or leave both empty.";
      if (d.end && d.start && d.end <= d.start)
        return "End time must be later than start time.";
      const conflict =
        (!id || d.start!==t.start || d.end!==t.end || d.date!==t.date) &&
        d.start &&
        d.end &&
        state.tasks.find(
          (x) =>
            x.id !== id &&
            x.date === d.date &&
            x.start &&
            x.end &&
            x.status !== "Cancelled" &&
            d.start < x.end &&
            d.end > x.start,
        );
      if (
        conflict &&
        !await ask("Scheduling overlap",`This overlaps with "${conflict.title}" (${conflict.start}–${conflict.end}). Keep both tasks at this time?`,"Keep both")
      )
        return "Choose a different time to avoid the overlap.";
      if (
        d.chapter &&
        state.chapters.find((c) => c.id === d.chapter)?.subject !== d.subject
      )
        return "Choose a chapter belonging to the selected subject.";
      d.title = d.title.trim();
      const record = {
        ...t,
        ...d,
        id: id || uid(),
        completedAt: d.status === "Completed" ? t.completedAt || today() : null,
      };
      if (id) Object.assign(t, record);
      else state.tasks.push(record);
      activity((id ? "Updated task: " : "Planned: ") + d.title);
    },
  );
  const subjectInput=$("#f-subject");
  subjectInput.onchange=()=>{
    $("#f-chapter").innerHTML='<option value="">No linked chapter</option>'+state.chapters.filter(c=>c.subject===subjectInput.value).map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join("");
  };
}
