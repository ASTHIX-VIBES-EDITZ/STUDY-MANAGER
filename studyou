          <section class="panel activity-panel"><div class="section-head"><h2>Small wins, recorded.</h2><span class="eyebrow muted">RECENT</span></div>${state.activity.length?state.activity.slice(0,3).map(a=>`<div class="history-item"><p>${esc(a.text)}</p><small class="muted">${new Date(a.date).toLocaleDateString(undefined,{month:"short",day:"numeric"})}</small></div>`).join(""):'<p class="muted small mt">Your completed tasks, chapters and focus sessions will leave a trail here.</p>'}<button class="text-btn mt" data-action="recommend">What should I study next? ↗</button></section>
        </div>
