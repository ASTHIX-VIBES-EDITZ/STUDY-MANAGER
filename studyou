  }catch{return null}
}
async function audioCache(operation,key,file){
  try{
    const db=await openAudioDB();
    if(!db)return null;
    return await new Promise(resolve=>{
      const tx=db.transaction("tracks",operation==="read"?"readonly":"readwrite"),store=tx.objectStore("tracks");
      let result=true;
      const request=operation==="put"?store.put({key,file}):operation==="delete"?store.delete(key):operation==="clear"?store.clear():store.getAll();
      request.onsuccess=()=>{if(operation==="read")result=request.result};
      tx.oncomplete=()=>resolve(result);
      tx.onerror=()=>resolve(null);tx.onabort=()=>resolve(null);
    });
  }catch{audioCacheAvailable=false;return null}
}
