        <section class="panel daily-goal"><div class="row between"><div class="eyebrow">DAILY FOCUS GOAL</div><span class="goal-percent">${dailyPercent}%</span></div><div class="goal-amount">${hourNumber(dayHours)} <span class="small muted">of ${state.profile.dailyHours} hours</span></div>${progress(dailyPercent)}<p class="help mt">${dayHours>=state.profile.dailyHours?"Daily goal reached. Make room for a break.":Math.max(0,state.profile.dailyHours-dayHours).toFixed(1)+" hours left on today’s goal."}</p></section>
        <section class="exam-mini panel"><div class="eyebrow muted">THE NEXT MILESTONE</div>${nearest?`<div class="mini-countdown">${daysUntil(nearest.date)}<small>DAYS TO GO</small></div><h3>${esc(nearest.name)}</h3><p class="help">${dateLabel(nearest.date)} · ${esc(subName(nearest.subject))}</p><button class="text-btn mt" data-page="exams">Your exam plan ↗</button>`:'<h3 class="mt">Give your preparation a finish line.</h3><button class="text-btn mt" data-action="add-exam">＋ Add an exam</button>'}</section>
      </aside>
    </div>`;
}
function focusPage() {
