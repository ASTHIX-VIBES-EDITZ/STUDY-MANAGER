function validImport(d) {
  if (!d || typeof d !== "object" || d.version !== 1) return false;
  const rules = {
    subjects: ["id", "name"],
    chapters: ["id", "name", "subject"],
    tasks: ["id", "title", "date"],
    notes: ["id", "title", "text"],
    formulas: ["id", "name", "formula"],
    exams: ["id", "name", "date"],
    sessions: ["id", "date", "type"],
    activity: ["id", "text", "date"],
    playlists: ["id", "name"],
  };
  for (const [k, fields] of Object.entries(rules)) {
    if (
      !Array.isArray(d[k]) ||
      d[k].some(
        (x) =>
          !x ||
          typeof x !== "object" ||
          fields.some((f) => typeof x[f] !== "string"),
      )
    )
      return false;
    if(new Set(d[k].map(x=>x.id)).size!==d[k].length)return false;
  }
  if (!d.profile || !d.settings || !d.music) return false;
  if (
    d.subjects.some((s) => !/^#[\da-f]{6}$/i.test(s.color)) ||
    d.notes.some((n) => !/^#[\da-f]{6}$/i.test(n.color)) ||
    d.playlists.some(
      (p) =>
        !/^#[\da-f]{6}$/i.test(p.color) ||
        !Array.isArray(p.tracks) ||
        p.tracks.some((x) => typeof x !== "string"),
    )
  )
    return false;
  if (
    d.chapters.some(
      (c) =>
        !Number.isFinite(c.total) ||
        c.total < 1 ||
        !Number.isFinite(c.completed) ||
        c.completed < 0 ||
        c.completed > c.total,
    ) ||
    d.sessions.some((s) => !Number.isFinite(s.seconds) || s.seconds < 0)
  )
    return false;
  if (
    typeof d.profile.name !== "string" ||
    !Number.isFinite(d.profile.dailyHours) ||
    d.profile.dailyHours <= 0 ||
    !Number.isFinite(d.profile.weeklyHours) ||
    d.profile.weeklyHours <= 0
  )
    return false;
  for (const k of ["focus", "short", "long", "rounds"])
    if (
      !Number.isFinite(d.settings[k]) ||
      d.settings[k] < 1 ||
      d.settings[k] > 240
    )
      return false;
  for (const [k,max] of [["short",60],["long",120],["rounds",12]]) if(d.settings[k]>max)return false;
  if(d.profile.dailyHours>24||d.profile.weeklyHours>168)return false;
  if(d.tasks.some(t=>!validDate(t.date)||!["Pending","In progress","Completed","Delayed","Cancelled"].includes(t.status)||!["Low","Medium","High","Urgent"].includes(t.priority)))return false;
  if(d.exams.some(e=>!validDate(e.date)||!Number.isFinite(Number(e.maximum))||Number(e.maximum)<=0||(e.obtained!==""&&e.obtained!=null&&(!Number.isFinite(Number(e.obtained))||Number(e.obtained)<0||Number(e.obtained)>Number(e.maximum)))))return false;
  if(d.sessions.some(s=>!validDate(s.date)||!["focus","short","long","stopwatch"].includes(s.type)))return false;
  if(d.chapters.some(c=>!Number.isInteger(c.total)||!Number.isInteger(c.completed)))return false;
  if(d.notes.some(n=>typeof n.text!=="string"))return false;
  return (
    ["dark", "light"].includes(d.theme) && Array.isArray(d.music.favorites)
  );
}
