          ${metric("CHAPTERS DONE",p.done+'<span class="unit"> / '+p.total+'</span>',p.percent+"% of your roadmap","02")}
          ${metric("TASKS COMPLETED",state.tasks.filter(t=>t.status==="Completed").length,pending.length+" tasks remaining","03")}
          ${metric("STUDY STREAK",streak()+'<span class="unit"> days</span>',"Personal best: "+longestStreak()+" days","04")}
        </section>
        <section class="daily-plan panel">
          <div class="section-head"><div><div class="eyebrow muted">THE DAILY PLAN</div><h2 class="mt-small">Today, one thing at a time.</h2></div><button class="text-btn" data-page="planner">Open planner ↗</button></div>
          <div class="week-strip" aria-label="This week">${Array.from({length:7},(_,i)=>{const d=new Date();d.setDate(d.getDate()-((d.getDay()+6)%7)+i);const key=dateKey(d),count=state.tasks.filter(t=>t.date===key&&t.status!=="Cancelled").length;return `<button class="week-day ${key===today()?"is-today":""}" data-action="desk-day" data-date="${key}" aria-label="Plan ${key}, ${count} tasks"><small>${d.toLocaleDateString(undefined,{weekday:"short"})}</small><b>${d.getDate()}</b><span class="day-count">${count?count+" tasks":"—"}</span></button>`}).join("")}</div>
          <div class="row between checklist-heading"><h3>Today’s checklist <span class="list-count">${done}/${todays.length}</span></h3><button class="text-btn" data-action="add-task">＋ Add task</button></div>
          ${progress(todays.length?done/todays.length*100:0)}
          <div class="today-task-list">${todays.length?todays.sort((a,b)=>(a.start||"99:99").localeCompare(b.start||"99:99")).slice(0,5).map(t=>taskRow(t,true)).join(""):empty("Your day is still a blank page.","Choose one thing you’d like to finish today.","add-task","Plan your first task")}</div>
          ${overdue?`<button class="overdue-link" data-action="show-overdue">${overdue} overdue task${overdue===1?"":"s"} need a new plan <span>Review ↗</span></button>`:""}
