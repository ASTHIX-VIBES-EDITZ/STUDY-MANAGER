}
function chapterCard(c) {
  const percent = Math.round((c.completed / Math.max(1, c.total)) * 100),
    overdue = c.date && c.date < today() && c.status !== "Completed";
  return `<article class="chapter"><div class="row between"><div class="grow"><h3>${esc(c.name)}</h3><p class="help">${esc(subName(c.subject))} · ${c.completed}/${c.total} topics ${c.date ? "· " + dateLabel(c.date) : ""}</p></div><button class="text-btn" data-action="edit-chapter" data-id="${esc(c.id)}">Edit</button></div><div class="row between mt"><span class="chip ${overdue ? "delayed" : ""}">${overdue ? "Overdue · " : ""}${esc(c.status)}</span><span class="small muted">${percent}%</span></div><input type="range" value="${c.completed}" min="0" max="${c.total}" data-chapter-progress="${esc(c.id)}" aria-label="${esc(c.name)} completed topics"><div class="row between"><button class="text-btn" data-action="complete-chapter" data-id="${esc(c.id)}">Mark complete</button><button class="text-btn" data-action="revise-chapter" data-id="${esc(c.id)}">Revise (${c.revisions || 0})</button><button class="text-btn danger" data-action="delete-chapter" data-id="${esc(c.id)}">Delete</button></div></article>`;
}
function tasksPage() {
  let ts = state.tasks.filter((t) => {
    const st = status(t);
    return (
      (taskFilter === "all" ||
        (taskFilter === "today" && t.date === today()) ||
        (taskFilter === "upcoming" && t.date > today() && st !== "Completed") ||
        (taskFilter === "completed" && st === "Completed") ||
        (taskFilter === "delayed" && st === "Delayed") ||
        (taskFilter === "high" && ["High", "Urgent"].includes(t.priority))) &&
      [
        t.title,
        subName(t.subject),
        t.notes,
        state.chapters.find((c) => c.id === t.chapter)?.name,
      ]
        .join(" ")
        .toLowerCase()
        .includes(taskSearch.toLowerCase())
    );
  });
  ts.sort((a, b) =>
    taskSort === "priority"
      ? ["Urgent", "High", "Medium", "Low"].indexOf(a.priority) -
        ["Urgent", "High", "Medium", "Low"].indexOf(b.priority)
      : taskSort === "status"
        ? status(a).localeCompare(status(b))
        : (a.date + (a.start || "")).localeCompare(b.date + (b.start || "")),
  );
  return `${heading("Tasks", "Plan, prioritise and finish your next piece of work.", "add-task", "＋ Add task")}<div class="toolbar"><input id="taskSearch" placeholder="Search tasks or subjects…" aria-label="Search tasks" value="${esc(taskSearch)}"><select id="taskSort" aria-label="Sort tasks">${[
    ["date", "Date & time"],
    ["priority", "Priority"],
    ["status", "Status"],
  ]
    .map(
      ([v, l]) =>
        `<option value="${v}" ${taskSort === v ? "selected" : ""}>${l}</option>`,
    )
    .join(
      "",
    )}</select><span class="small muted">${state.tasks.filter((t) => t.status === "Completed").length} / ${state.tasks.length} completed</span></div><div class="filters mb">${[
    ["all", "All tasks"],
    ["today", "Today"],
    ["upcoming", "Upcoming"],
    ["completed", "Completed"],
    ["delayed", "Delayed"],
    ["high", "High priority"],
  ]
    .map(
      ([f, l]) =>
        `<button class="filter ${taskFilter === f ? "active" : ""}" data-action="task-filter" data-filter="${f}">${l}</button>`,
    )
    .join(
      "",
    )}</div><section class="panel list-panel">${ts.length ? ts.map((t) => taskRow(t, true)).join("") : empty("A clear list. A calmer mind.", "Add a task, or try a different filter.", "add-task", "＋ Add task")}</section>`;
