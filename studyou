    .map(
      ([m, l]) =>
        `<button data-action="timer-mode" data-mode="${m}" class="${timer.mode === m ? "active" : ""}" ${timer.running ? "disabled" : ""}>${l}</button>`,
    )
    .join(
      "",
    )}</div><div class="timer-ring"><svg viewBox="0 0 220 220" aria-hidden="true"><circle cx="110" cy="110" r="100"/><circle class="fill" id="timerArc" cx="110" cy="110" r="100"/></svg><div><div class="timer-digits" id="timerDigits">25:00</div><small id="timerCaption">A little focus goes a long way</small></div></div><label class="small muted" for="timerSubject">SESSION SUBJECT</label><select id="timerSubject" class="timer-select mt" ${timer.running ? "disabled" : ""}>${subjectOptions(timer.subject)}</select><div class="timer-buttons"><button class="icon-btn" data-action="timer-reset" aria-label="Reset timer" title="Reset timer">↻</button><button class="btn primary" data-action="timer-start" id="timerStart">▶ Start focus</button><button class="icon-btn" data-action="timer-skip" aria-label="Skip session" title="Skip session">›Ⅰ</button></div><div class="row between mt"><button class="text-btn" data-action="save-session">Save elapsed time</button><button class="text-btn" data-action="fullscreen">Expand ↗</button></div><p class="session-label">${state.sessions.filter((s) => s.date === today() && isStudy(s)).length} focus sessions today · Round ${timer.round + 1}</p></section>`;
}
function dashboard() {
