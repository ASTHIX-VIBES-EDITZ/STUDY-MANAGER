function formModal(title, fields, saveFn, extra = "") {
  openModal(
    title,
    `<form id="editorForm"><div class="form-grid">${fields}</div><p class="danger small mt" id="formError" role="alert"></p>${extra}<div class="dialog-actions"><button type="button" class="btn outline" data-action="close-modal">Cancel</button><button type="submit" class="btn primary">Save changes</button></div></form>`,
  );
  $("#editorForm").onsubmit = async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(e.currentTarget));
    const submit=e.currentTarget.querySelector('[type="submit"]');
    if(submit.disabled)return;
    submit.disabled=true;
    try {
      const error = await saveFn(data);
      if (error) {
        $("#formError").textContent = error;
        return;
      }
      save();
      closeModal();
      render();
      notify("Saved to your workspace.");
    } catch (err) {
      $("#formError").textContent =
        "Could not save. Check your values and try again.";
      console.error(err);
    } finally {
      submit.disabled=false;
    }
  };
}
function taskEditor(id = "", date = today()) {
  const t = state.tasks.find((x) => x.id === id) || {
