function plannerPage() {
  const year = calendarDate.getFullYear(),
    month = calendarDate.getMonth(),
    first = new Date(year, month, 1),
    start = new Date(first);
  start.setDate(first.getDate() - ((first.getDay() + 6) % 7));
  const dayTasks = state.tasks.filter((t) => t.date === selectedDate);
  let cells = "";
  for (let i = 0; i < 42; i++) {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    const k = dateKey(d),
      tasks = state.tasks.filter((t) => t.date === k),
      exams = state.exams.filter((e) => e.date === k);
    cells += `<button class="cal-day ${d.getMonth() !== month ? "outside" : ""} ${k === today() ? "today" : ""} ${k === selectedDate ? "selected" : ""}" data-action="select-day" data-date="${k}" data-drop-date="${k}" aria-label="${d.toLocaleDateString()}, ${tasks.length} tasks, ${exams.length} exams"><span class="day-num">${d.getDate()}</span>${tasks
      .slice(0, 2)
      .map(
        (t) =>
          `<span class="cal-task">${t.status === "Completed" ? "✓ " : ""}${esc(t.title)}</span>`,
      )
      .join(
        "",
      )}${exams.length ? '<span class="cal-task accent">Exam day</span>' : ""}${tasks.length || exams.length ? '<span class="cal-dot"></span>' : ""}</button>`;
  }
  return `${heading("Planner", "Your monthly calendar and daily study agenda.", "add-task", "＋ Add task")}<section class="panel"><div class="section-head"><div class="row"><button class="icon-btn" data-action="prev-month" aria-label="Previous month">‹</button><h2>${calendarDate.toLocaleDateString(undefined, { month: "long", year: "numeric" })}</h2><button class="icon-btn" data-action="next-month" aria-label="Next month">›</button></div><div class="row"><button class="btn small outline" data-action="cal-today">Today</button><button class="text-btn" data-action="print">Print</button></div></div><div class="calendar">${["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"].map((d) => `<div class="cal-head">${d}</div>`).join("")}${cells}</div></section><section class="panel mt"><div class="section-head"><h2>${new Date(selectedDate + "T12:00:00").toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long" })}</h2><button class="text-btn" data-action="add-day-task">＋ Plan this day</button></div>${
    dayTasks.length
      ? dayTasks
          .sort((a, b) => (a.start || "").localeCompare(b.start || ""))
          .map((t) => taskRow(t, true))
          .join("")
      : empty(
          "Some room in your day.",
          "Set an intention for this date.",
          "add-day-task",
          "Add a task",
        )
  }${state.exams
    .filter((e) => e.date === selectedDate)
    .map(
      (e) =>
        `<div class="notice mt">EXAM · ${esc(e.name)} · ${esc(subName(e.subject))}</div>`,
    )
    .join(
      "",
    )}<p class="help mt">${daySessions(selectedDate).filter(isStudy).length} focus sessions · ${hourNumber(hours(daySessions(selectedDate)))} study hours. Drag a task from this list onto a calendar day to reschedule.</p></section>`;
}
