<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta
      name="description"
      content="An offline study workspace with tasks, chapters, focus sessions, planning, notes and your own music."
    />
    <title>Study Tracker Pro · Your space to focus</title>
    <style>
      @font-face {
  font-family: Satoshi;
  src: url(data:font/woff2;base64,)
    format("woff2");
  font-weight: 400;
  font-display: swap;
}
:root {
  --font-body: "Satoshi", system-ui, sans-serif;
  --font-display: var(--font-body);
  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: clamp(1.5rem, 2.3vw, 2rem);
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-16: 64px;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --color-bg: #111312;
  --surface: #1a1d1b;
  --surface2: #232724;
  --surface3: #2c312d;
  --line: #ffffff12;
  --text: #f2f4ef;
  --muted: #a7afa8;
  --accent: #b8e59a;
  --accent-text: #172313;
  --warning: #efb780;
  --danger: #f2a6a6;
  --sidebar: #101211;
  --shadow: 0 16px 64px #0004;
}
[data-theme="light"] {
  --color-bg: #f3f5ef;
  --surface: #fff;
  --surface2: #eaf0e5;
  --surface3: #dde5d7;
  --line: #18241418;
  --text: #20291e;
  --muted: #596451;
  --accent: #477a2e;
  --accent-text: #fff;
  --warning: #85501c;
  --danger: #a22d38;
  --sidebar: #e8ede3;
  --shadow: 0 16px 64px #18301012;
}
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
html {
  -webkit-font-smoothing: antialiased;
  text-size-adjust: none;
  scroll-behavior: smooth;
}
body {
  font: var(--text-sm)/1.6 var(--font-body);
  color: var(--text);
  background: var(--color-bg);
}
button,
input,
select,
textarea {
  font: inherit;
  color: inherit;
}
button {
  cursor: pointer;
  border: 0;
  background: none;
}
button,
a,
input,
textarea,
select {
  transition:
    background 0.18s,
    color 0.18s,
    border-color 0.18s,
    transform 0.18s;
}
button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}
button:hover:not(:disabled) {
  filter: brightness(1.1);
}
button:active:not(:disabled) {
  transform: translateY(1px);
}
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}
input,
select,
textarea {
  width: 100%;
  background: var(--surface2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
  min-height: 44px;
}
textarea {
  resize: vertical;
  min-height: 100px;
}
input[type="checkbox"] {
  width: 20px;
  min-height: 20px;
  accent-color: var(--accent);
  cursor: pointer;
}
input[type="range"] {
  accent-color: var(--accent);
  min-height: 24px;
  padding: 0;
  border: 0;
}
input[type="color"] {
  padding: var(--space-1);
}
h1,
h2,
h3 {
  line-height: 1.25;
  text-wrap: balance;
}
h1 {
  font-size: var(--text-xl);
  letter-spacing: -0.035em;
}
h2 {
  font-size: var(--text-lg);
  letter-spacing: -0.02em;
}
h3 {
  font-size: var(--text-base);
}
p {
  max-width: 72ch;
}
small,
.small {
  font-size: var(--text-xs);
}
svg {
  display: block;
  max-width: 100%;
}
a {
  color: var(--accent);
}
.muted {
  color: var(--muted);
}
.accent {
  color: var(--accent);
}
.danger {
  color: var(--danger);
}
.eyebrow {
  font-size: var(--text-xs);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 700;
}
.skip {
  position: fixed;
  top: -60px;
  left: 16px;
  z-index: 200;
  background: var(--accent);
  color: var(--accent-text);
  padding: 12px;
}
.skip:focus {
  top: 12px;
}
.shell {
  display: grid;
  grid-template-columns: 224px minmax(0, 1fr);
  min-height: 100vh;
  padding-bottom: 88px;
}
.sidebar {
  position: fixed;
  inset: 0 auto 88px 0;
  width: 224px;
  background: var(--sidebar);
  padding: var(--space-8) var(--space-4);
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--line);
  z-index: 30;
  overflow: auto;
}
.brand {
  padding: 0 var(--space-3) var(--space-8);
  font-size: var(--text-lg);
  font-weight: 900;
  letter-spacing: -0.04em;
}
.brand span {
  display: block;
  font-weight: 400;
  font-size: var(--text-xs);
  letter-spacing: 0.14em;
  color: var(--muted);
  margin-top: 4px;
}
.nav-label {
  font-size: var(--text-xs);
  color: var(--muted);
  letter-spacing: 0.12em;
  margin: var(--space-5) var(--space-3) var(--space-2);
}
.nav-button {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  width: 100%;
  padding: var(--space-3);
  text-align: left;
  border-radius: var(--radius-sm);
  color: var(--muted);
  min-height: 44px;
}
.nav-button:hover {
  color: var(--text);
  background: var(--surface);
}
.nav-button.active {
  background: var(--surface2);
  color: var(--accent);
  font-weight: 700;
}
.nav-icon {
  font-size: var(--text-lg);
  width: 24px;
  text-align: center;
}
.side-bottom {
  margin-top: auto;
  padding-top: var(--space-8);
}
.side-quote {
  padding: var(--space-4);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
}
.side-quote p {
  color: var(--muted);
  font-size: var(--text-xs);
  margin-top: var(--space-2);
}
.local-badge {
  font-size: var(--text-xs);
  color: var(--muted);
  padding: var(--space-4) var(--space-2) 0;
}
.dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  margin-right: var(--space-2);
}
.main {
  grid-column: 2;
  min-width: 0;
}
.topbar {
  height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: 0 var(--space-8);
  border-bottom: 1px solid var(--line);
}
.breadcrumbs {
  color: var(--muted);
  white-space: nowrap;
}
.breadcrumbs b {
  font-weight: 500;
  color: var(--text);
}
.search-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  width: 320px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 30px;
  padding: 0 var(--space-4);
}
.search-wrap input {
  background: none;
  border: 0;
  padding-left: 0;
  min-width: 0;
}
.key {
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 0 4px;
  font-size: var(--text-xs);
  color: var(--muted);
}
.top-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.icon-btn {
  display: grid;
  place-items: center;
  min-width: 44px;
  min-height: 44px;
  border-radius: 50%;
  color: var(--muted);
  font-size: var(--text-lg);
}
.icon-btn:hover {
  background: var(--surface2);
  color: var(--text);
}
.avatar {
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: 50%;
  background: #d9cba9;
  color: #332d21;
  display: grid;
  place-items: center;
  font-weight: 700;
}
.page {
  max-width: 1660px;
  padding: var(--space-8);
  margin: auto;
  min-width: 0;
}
.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}
.page-heading p {
  color: var(--muted);
  margin-top: var(--space-2);
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-5);
  border-radius: 30px;
  background: var(--surface2);
  color: var(--text);
  min-height: 44px;
  font-weight: 700;
  font-size: var(--text-sm);
  white-space: nowrap;
}
.btn.primary {
  background: var(--accent);
  color: var(--accent-text);
}
.btn.outline {
  border: 1px solid var(--line);
  background: transparent;
}
.btn.small {
  padding: var(--space-2) var(--space-4);
  font-size: var(--text-xs);
}
.text-btn {
  color: var(--muted);
  font-size: var(--text-xs);
  min-height: 44px;
  padding: var(--space-2);
}
.text-btn:hover {
  color: var(--accent);
}
.row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.between {
  justify-content: space-between;
}
.wrap {
  flex-wrap: wrap;
}
.grow {
  flex: 1;
  min-width: 0;
}
.stack {
  display: grid;
  gap: var(--space-5);
}
.gap8 {
  gap: var(--space-2);
}
.mt {
  margin-top: var(--space-5);
}
.mb {
  margin-bottom: var(--space-5);
}
.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 304px;
  gap: var(--space-6);
}
.hero {
  background: linear-gradient(110deg, #354a35, #26362e 65%, #202d27);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  min-height: 214px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  color: #f2f4ef;
  overflow: hidden;
}
.hero h2 {
  font-size: var(--text-xl);
  margin: var(--space-3) 0;
  max-width: 390px;
}
.hero p {
  color: #c0cdbf;
  max-width: 340px;
}
.hero .eyebrow {
  color: #c4ddb6;
}
.hero .btn {
  background: #b8e59a;
  color: #172313;
  margin-top: var(--space-5);
}
.hero-art {
  width: 150px;
  height: 150px;
  flex-shrink: 0;
  position: relative;
  border-radius: 50%;
  border: 1px solid #b8e59a30;
  display: grid;
  place-items: center;
}
.hero-art::before,
.hero-art::after {
  content: "";
  position: absolute;
  border: 1px solid #b8e59a30;
  border-radius: 50%;
  inset: 14px;
}
.hero-art::after {
  inset: 30px;
}
.hero-art .orbit-text {
  font-size: var(--text-xl);
  font-weight: 700;
  color: #d9e9ce;
  letter-spacing: -0.1em;
}
.hero-art small {
  position: absolute;
  bottom: 20px;
  color: #b8c6b2;
}
.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
  margin: var(--space-5) 0 var(--space-6);
}
.stat {
  padding: var(--space-5);
  border-radius: var(--radius-md);
  background: var(--surface);
}
.stat .label {
  color: var(--muted);
  font-size: var(--text-xs);
}
.stat strong {
  font-size: var(--text-xl);
  display: block;
  letter-spacing: -0.04em;
  margin: var(--space-2) 0;
}
.stat small {
  color: var(--muted);
}
.stat .stat-top {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  gap: var(--space-3);
}
.panel {
  border-radius: var(--radius-md);
  padding: var(--space-5);
  background: var(--surface);
  min-width: 0;
}
.subject-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-4);
}
.subject-card {
  border-radius: var(--radius-md);
  background: var(--surface);
  overflow: hidden;
  text-align: left;
  min-width: 0;
}
.subject-cover {
  height: 100px;
  position: relative;
  overflow: hidden;
  background: var(--cover);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5);
  color: #ffffffde;
}
.subject-cover .symbol {
  font-size: var(--text-xl);
  font-weight: 500;
  opacity: 0.85;
}
.subject-cover .cover-name {
  font-size: var(--text-xs);
  letter-spacing: 0.16em;
  writing-mode: vertical-rl;
}
.subject-cover::after {
  content: "";
  position: absolute;
  inset: 16px 50px 16px 16px;
  border: 1px solid #ffffff24;
  border-radius: 50%;
  transform: rotate(-25deg);
}
.subject-body {
  padding: var(--space-4);
}
.subject-body p {
  color: var(--muted);
  font-size: var(--text-xs);
  margin: var(--space-2) 0 var(--space-3);
}
.progress {
  height: 5px;
  border-radius: 5px;
  background: var(--surface3);
  overflow: hidden;
}
.progress > span {
  display: block;
  height: 100%;
  background: var(--accent);
  border-radius: 5px;
  transition: width 0.3s;
}
.progress-caption {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  color: var(--muted);
  margin-top: var(--space-2);
}
.dashboard-lower {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: var(--space-5);
  margin-top: var(--space-6);
}
.task-row {
  display: flex;
  gap: var(--space-3);
  align-items: center;
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--line);
  min-width: 0;
}
.task-row:last-child {
  border-bottom: 0;
}
.task-row.done .task-title {
  text-decoration: line-through;
  color: var(--muted);
}
.check-wrap {
  min-height: 44px;
  min-width: 28px;
  display: flex;
  align-items: center;
}
.task-title {
  font-weight: 500;
  overflow-wrap: anywhere;
}
.task-meta {
  font-size: var(--text-xs);
  color: var(--muted);
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-top: 4px;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) var(--space-2);
  font-size: var(--text-xs);
  border-radius: 5px;
  background: var(--surface2);
  color: var(--muted);
  overflow-wrap: anywhere;
}
.chip.high,
.chip.urgent {
  color: var(--warning);
  background: #d3934220;
}
.chip.completed {
  color: var(--accent);
}
.chip.delayed {
  color: var(--danger);
}
.empty {
  padding: var(--space-8) var(--space-4);
  text-align: center;
  color: var(--muted);
}
.empty h3 {
  color: var(--text);
  margin-bottom: var(--space-2);
}
.empty .btn {
  margin-top: var(--space-4);
}
.empty-icon {
  font-size: var(--text-xl);
  margin-bottom: var(--space-3);
  color: var(--accent);
}
.chart {
  width: 100%;
  height: 130px;
  display: flex;
  align-items: flex-end;
  gap: var(--space-3);
  padding-top: var(--space-4);
}
.bar-wrap {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2);
  min-width: 0;
}
.bar {
  width: 100%;
  max-width: 28px;
  background: #728b65;
  border-radius: 4px 4px 0 0;
  min-height: 3px;
}
.bar.today {
  background: var(--accent);
}
.bar-wrap small {
  color: var(--muted);
}
.chart-total {
  font-size: var(--text-lg);
  font-weight: 700;
}
.chart-total span {
  font-size: var(--text-xs);
  color: var(--muted);
  font-weight: 400;
}
.timer-panel {
  text-align: center;
}
.timer-tabs {
  display: flex;
  padding: 4px;
  background: var(--color-bg);
  border-radius: 24px;
  margin: var(--space-5) 0;
}
.timer-tabs button {
  flex: 1;
  font-size: var(--text-xs);
  padding: var(--space-2) var(--space-1);
  border-radius: 20px;
  color: var(--muted);
  min-height: 36px;
}
.timer-tabs button.active {
  background: var(--surface3);
  color: var(--text);
}
.timer-ring {
  width: 218px;
  height: 218px;
  margin: var(--space-5) auto;
  position: relative;
  display: grid;
  place-items: center;
}
.timer-ring svg {
  position: absolute;
  inset: 0;
  transform: rotate(-90deg);
  width: 100%;
  height: 100%;
}
.timer-ring circle {
  fill: none;
  stroke: var(--surface3);
  stroke-width: 4;
}
.timer-ring .fill {
  stroke: var(--accent);
  stroke-linecap: round;
  stroke-dasharray: 628.319;
  stroke-dashoffset: 0;
  transition: stroke-dashoffset 0.5s;
}
.timer-digits {
  font-size: clamp(2.5rem, 4vw, 3.25rem);
  font-weight: 500;
  letter-spacing: -0.05em;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}
.timer-ring small {
  color: var(--muted);
  font-size: var(--text-xs);
}
.timer-select {
  background: var(--surface2);
  font-size: var(--text-xs);
  margin-bottom: var(--space-4);
}
.timer-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
}
.timer-buttons .primary {
  min-width: 138px;
}
.timer-panel .session-label {
  font-size: var(--text-xs);
  color: var(--muted);
  margin-top: var(--space-4);
}
.goal-row {
  padding: var(--space-4) 0;
}
.goal-amount {
  font-size: var(--text-lg);
  font-weight: 700;
  margin: var(--space-3) 0;
}
.quote {
  padding: var(--space-5);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  color: var(--muted);
  font-size: var(--text-xs);
}
.quote p {
  color: var(--text);
  font-size: var(--text-sm);
  margin: var(--space-3) 0;
}
.focus-workspace {
  display: grid;
  grid-template-columns: minmax(280px, 500px) minmax(240px, 1fr);
  gap: var(--space-6);
  max-width: 1100px;
  margin: auto;
}
.focus-workspace .timer-ring {
  width: 280px;
  height: 280px;
}
.focus-workspace .timer-digits {
  font-size: 3.25rem;
}
.focus-workspace .timer-tabs button {
  min-height: 44px;
}
.toolbar {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-5);
}
.toolbar input {
  max-width: 320px;
}
.toolbar select {
  max-width: 190px;
}
.filters {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.filter {
  padding: var(--space-2) var(--space-4);
  border: 1px solid var(--line);
  border-radius: 24px;
  font-size: var(--text-xs);
  color: var(--muted);
  min-height: 40px;
}
.filter.active {
  color: var(--accent);
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 8%, transparent);
}
.list-panel {
  padding: var(--space-2) var(--space-5);
}
.three-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-5);
}
.two-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-5);
}
.chapter {
  padding: var(--space-4);
  background: var(--surface2);
  border-radius: var(--radius-sm);
  margin-top: var(--space-3);
}
.chapter input[type="range"] {
  margin-top: var(--space-3);
}
.chapter .row {
  align-items: start;
}
.note {
  background: var(--note-bg, #e4dfb0);
  color: #292c21;
  border-radius: 3px 14px 14px 14px;
  padding: var(--space-5);
  min-height: 210px;
  position: relative;
  overflow-wrap: anywhere;
  resize: vertical;
  overflow: auto;
}
.note p {
  white-space: pre-wrap;
  margin-top: var(--space-4);
}
.note .text-btn {
  color: #47513c;
}
.notes-board {
  background-image: radial-gradient(var(--line) 1px, transparent 1px);
  background-size: 20px 20px;
  min-height: 50vh;
  padding: var(--space-4);
}
.formula-line {
  font-family: ui-monospace, monospace;
  font-size: var(--text-lg);
  padding: var(--space-5) 0;
  overflow-wrap: anywhere;
  color: var(--accent);
  white-space: pre-wrap;
}
.formula-card p {
  white-space: pre-wrap;
}
.calendar {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.cal-head {
  padding: var(--space-3);
  text-align: center;
  background: var(--surface);
  font-size: var(--text-xs);
  color: var(--muted);
}
.cal-day {
  background: var(--surface);
  padding: var(--space-3);
  min-height: 105px;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  border: 1px solid transparent;
  min-width: 0;
}
.cal-day:hover {
  background: var(--surface2);
}
.cal-day.selected {
  border-color: var(--accent);
}
.cal-day.today .day-num {
  color: var(--accent);
  font-weight: 900;
}
.cal-day.outside {
  opacity: 0.35;
}
.cal-task {
  font-size: var(--text-xs);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  max-width: 100%;
  background: var(--surface2);
  padding: var(--space-1);
  border-radius: 3px;
}
.cal-dot {
  width: 5px;
  height: 5px;
  background: var(--accent);
  border-radius: 50%;
}
.countdown {
  font-size: var(--text-xl);
  font-weight: 700;
  letter-spacing: -0.04em;
  margin: var(--space-5) 0;
}
.countdown span {
  font-size: var(--text-sm);
  color: var(--muted);
  letter-spacing: 0;
  font-weight: 400;
}
.heatmap {
  display: grid;
  grid-template-columns: repeat(14, 1fr);
  gap: var(--space-2);
  margin-top: var(--space-5);
}
.heat-cell {
  aspect-ratio: 1;
  background: var(--surface3);
  border-radius: 3px;
}
.heat-cell.on {
  background: var(--accent);
}
.report-row {
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--line);
}
.report-row:last-child {
  border: 0;
}
.field {
  display: grid;
  gap: var(--space-2);
  min-width: 0;
}
.field > label {
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--muted);
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}
.full {
  grid-column: 1/-1;
}
.help {
  font-size: var(--text-xs);
  color: var(--muted);
  margin-top: var(--space-2);
}
.settings-section {
  margin-bottom: var(--space-6);
}
.settings-section h2 {
  margin-bottom: var(--space-4);
}
.notice {
  padding: var(--space-4);
  background: var(--surface2);
  border-radius: var(--radius-sm);
  color: var(--muted);
  font-size: var(--text-xs);
}
.history-item {
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--line);
}
.music-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 88px;
  z-index: 40;
  background: var(--sidebar);
  border-top: 1px solid var(--line);
  display: grid;
  grid-template-columns: 1fr 1.1fr 1fr;
  align-items: center;
  gap: var(--space-5);
  padding: var(--space-3) var(--space-6);
}
.track-info {
  display: flex;
  gap: var(--space-3);
  align-items: center;
  min-width: 0;
}
.album {
  width: 52px;
  height: 52px;
  border-radius: 6px;
  background: linear-gradient(140deg, #b8c6a1, #456350 55%, #263c34);
  display: grid;
  place-items: center;
  flex-shrink: 0;
  color: #edf4e4;
  font-size: var(--text-lg);
}
.track-name {
  font-weight: 700;
  font-size: var(--text-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 220px;
}
.music-center {
  display: grid;
  gap: var(--space-1);
  justify-items: center;
}
.music-controls {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}
.music-controls .icon-btn {
  min-width: 32px;
  min-height: 32px;
  font-size: var(--text-sm);
}
.play-circle {
  background: var(--text);
  color: var(--color-bg) !important;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: grid;
  place-items: center;
}
.seek-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--muted);
  font-size: var(--text-xs);
}
.seek-row input {
  height: 4px;
  min-height: 12px;
}
.music-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-3);
}
.music-right input {
  max-width: 100px;
}
.music-empty {
  min-height: 230px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-8);
  background: linear-gradient(110deg, #344b3e, #1d3028);
  border-radius: var(--radius-lg);
  color: #f1f5ed;
}
.music-empty h2 {
  font-size: var(--text-xl);
  margin: var(--space-3) 0;
}
.music-empty p {
  color: #bfcdbf;
}
.playlist-cover {
  height: 115px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: flex-end;
  padding: var(--space-4);
  color: #fff;
  background: var(--cover, #466047);
  font-size: var(--text-lg);
  font-weight: 700;
}
.playlist-card {
  padding: var(--space-4);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  text-align: left;
}
.playlist-card p {
  margin-top: var(--space-3);
  color: var(--muted);
  font-size: var(--text-xs);
}
dialog {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  width: 560px;
  max-width: calc(100% - 32px);
  max-height: 90dvh;
  margin: auto;
  box-shadow: var(--shadow);
}
dialog::backdrop {
  background: #0009;
  backdrop-filter: blur(5px);
}
.dialog-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-5);
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-3);
  margin-top: var(--space-6);
}
.toast {
  position: fixed;
  bottom: 104px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 150;
  background: var(--accent);
  color: var(--accent-text);
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  font-size: var(--text-sm);
  max-width: 90%;
  text-align: center;
}
.storage-warning {
  background: #453821;
  color: #f0d8b1;
  padding: var(--space-2) var(--space-4);
  font-size: var(--text-xs);
}
.mobile-menu {
  display: none;
}
.hidden {
  display: none !important;
}
.search-results button {
  display: block;
  text-align: left;
  width: 100%;
  padding: var(--space-4);
  border-bottom: 1px solid var(--line);
}
.search-results button:hover {
  background: var(--surface2);
}
.focus-only .sidebar,
.focus-only .topbar,
.focus-only .music-bar {
  display: none;
}
.focus-only .shell {
  display: block;
  padding-bottom: 0;
}
.focus-only .main {
  min-height: 100vh;
}
.focus-only .page {
  padding-top: var(--space-12);
}
body.compact .page {
  padding: var(--space-5);
}
body.compact .panel {
  padding: var(--space-4);
}
.backdrop {
  display: none;
}
@media (min-width: 1500px) {
  .dashboard-grid {
    grid-template-columns: minmax(0, 1fr) 330px;
  }
  .hero {
    min-height: 230px;
  }
  .subject-cover {
    height: 120px;
  }
  .stats {
    gap: var(--space-5);
  }
}
@media (max-width: 1200px) {
  .shell {
    grid-template-columns: 190px minmax(0, 1fr);
  }
  .sidebar {
    width: 190px;
    padding-inline: var(--space-3);
  }
  .page {
    padding: var(--space-6);
  }
  .topbar {
    padding-inline: var(--space-6);
  }
  .dashboard-grid {
    grid-template-columns: minmax(0, 1fr) 274px;
    gap: var(--space-5);
  }
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }
  .subject-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .subject-grid .subject-card:last-child {
    display: none;
  }
  .dashboard-lower {
    grid-template-columns: 1fr;
  }
  .three-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .search-wrap {
    width: 240px;
  }
  .hero-art {
    width: 110px;
    height: 110px;
  }
  .hero {
    padding: var(--space-6);
  }
}
@media (max-width: 980px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
  .dashboard-aside {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }
  .dashboard-aside .quote {
    display: none;
  }
  .dashboard-aside > .panel {
    margin: 0;
  }
  .dashboard-lower {
    grid-template-columns: 1fr 1fr;
  }
  .search-wrap {
    width: 200px;
  }
  .breadcrumbs {
    display: none;
  }
  .focus-workspace {
    grid-template-columns: 1fr;
  }
  .music-right .btn {
    display: none;
  }
  .music-bar {
    grid-template-columns: 1fr 1fr;
  }
  .music-right {
    display: none;
  }
  .three-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .subject-grid .subject-card:last-child {
    display: block;
  }
  .subject-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
@media (max-width: 700px) {
  .shell {
    display: block;
    padding-bottom: 100px;
  }
  .sidebar {
    transform: translateX(-100%);
    width: 240px;
    inset: 0 auto 0 0;
    transition: transform 0.2s;
  }
  .sidebar.open {
    transform: translateX(0);
  }
  .backdrop.open {
    display: block;
    position: fixed;
    inset: 0;
    background: #0008;
    z-index: 25;
  }
  .mobile-menu {
    display: grid;
  }
  .topbar {
    height: 72px;
    padding: var(--space-3) var(--space-4);
    gap: var(--space-2);
  }
  .search-wrap {
    width: auto;
    flex: 1;
    min-width: 0;
  }
  .search-wrap .key {
    display: none;
  }
  .top-actions {
    gap: 0;
  }
  .top-actions .avatar {
    display: none;
  }
  .page {
    padding: var(--space-5) var(--space-4);
  }
  .page-heading {
    align-items: flex-start;
  }
  .page-heading .btn {
    padding: var(--space-3);
    font-size: var(--text-xs);
  }
  .page-heading p {
    font-size: var(--text-xs);
  }
  .hero {
    min-height: 224px;
    padding: var(--space-5);
  }
  .hero h2 {
    font-size: 1.6rem;
  }
  .hero-art {
    display: none;
  }
  .stats {
    gap: var(--space-3);
    margin-block: var(--space-4) var(--space-6);
  }
  .stat {
    padding: var(--space-4);
  }
  .subject-grid {
    grid-template-columns: 1fr;
  }
  .subject-grid .subject-card:last-child {
    display: block;
  }
  .subject-card {
    display: flex;
  }
  .subject-cover {
    width: 88px;
    height: auto;
    min-height: 120px;
    flex-shrink: 0;
    padding: var(--space-3);
  }
  .subject-cover::after {
    inset: 12px;
  }
  .subject-cover .cover-name {
    display: none;
  }
  .subject-body {
    flex: 1;
    min-width: 0;
  }
  .dashboard-lower,
  .dashboard-aside,
  .two-grid,
  .three-grid {
    grid-template-columns: 1fr;
  }
  .dashboard-aside .quote {
    display: block;
  }
  .music-bar {
    grid-template-columns: minmax(0, 1fr) 132px;
    padding: var(--space-3) var(--space-4);
    gap: var(--space-3);
    min-height: 88px;
  }
  .album {
    width: 44px;
    height: 44px;
  }
  .music-controls {
    gap: var(--space-3);
  }
  .music-controls .optional {
    display: none;
  }
  .seek-row {
    display: none;
  }
  .track-name {
    max-width: 155px;
  }
  .music-center {
    justify-items: end;
  }
  .timer-ring {
    width: 210px;
    height: 210px;
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .full {
    grid-column: auto;
  }
  .cal-day {
    min-height: 70px;
    padding: var(--space-2);
  }
  .cal-task {
    display: none;
  }
  .cal-head {
    padding: var(--space-2);
    font-size: var(--text-xs);
  }
  .calendar {
    margin-inline: -4px;
  }
  .toolbar {
    gap: var(--space-2);
  }
  .toolbar input,
  .toolbar select {
    max-width: none;
    flex: 1;
    min-width: 140px;
  }
  .task-row {
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .task-row > .grow {
    flex-basis: 60%;
  }
  .task-row > .task-actions {
    margin-left: auto;
  }
  .task-actions .icon-btn {
    min-width: 36px;
  }
  .music-empty {
    padding: var(--space-5);
    min-height: 260px;
  }
  .music-empty .album {
    display: none;
  }
  .focus-workspace .timer-ring {
    width: 230px;
    height: 230px;
  }
  .focus-workspace .timer-digits {
    font-size: 2.8rem;
  }
  .page-heading .row {
    flex-wrap: wrap;
  }
  .heatmap {
    gap: 4px;
  }
  .search-wrap input {
    font-size: var(--text-xs);
  }
}
@media (max-width: 700px) {
  #favTrack {
    display: none;
  }
  #trackSub {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-info {
    overflow: hidden;
  }
  .track-name {
    max-width: 100%;
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
    scroll-behavior: auto !important;
  }
}
@media print {
  .sidebar,
  .topbar,
  .music-bar,
  .btn,
  .icon-btn,
  .toolbar {
    display: none !important;
  }
  .shell {
    display: block;
  }
  .page {
    padding: 0;
  }
  .panel {
    break-inside: avoid;
  }
  body {
    background: white;
    color: black;
  }
  input {
    border: 0;
  }
}

/* Study desk, edition 02. Paper surfaces, ink navigation, coloured subject collections. */
:root,[data-theme="light"]{
  --color-bg:#f6f5ef;--surface:#ffffff;--surface2:#eeeee8;--surface3:#e3e5de;
  --line:#23364a1a;--text:#23354b;--muted:#596775;--accent:#bc452c;--accent-text:#ffffff;
  --warning:#9a4b18;--danger:#ad3243;--sidebar:#182d43;--shadow:0 20px 80px #172c4020;
  --radius-sm:7px;--radius-md:12px;--radius-lg:16px;
  --text-xs:.75rem;--text-sm:.875rem;--text-base:1rem;--text-lg:1.125rem;
  --text-xl:clamp(1.5rem,2.3vw,2rem);
}
[data-theme="dark"]{
  --color-bg:#142234;--surface:#1c2d41;--surface2:#26394f;--surface3:#334860;
  --line:#edf3ff18;--text:#ecf1f8;--muted:#b0bece;--accent:#ffb199;--accent-text:#342017;
  --warning:#f4c18c;--danger:#ffb5c2;--sidebar:#101c2b;--shadow:0 20px 80px #0005;
}
body{font-size:var(--text-sm);line-height:1.6}
body,button,input,select,textarea{letter-spacing:.005em}
h1,h2,h3{font-weight:700;letter-spacing:-.035em;overflow-wrap:anywhere}
button,input,select,textarea{font-size:var(--text-sm)}
.shell{grid-template-columns:232px minmax(0,1fr);padding-bottom:84px}
.sidebar{width:232px;inset:0 auto 84px 0;padding:var(--space-8) var(--space-4);border:0;color:#eef4fa}
.brand{font-size:var(--text-xl);font-weight:700;line-height:1;letter-spacing:-.055em;padding:0 var(--space-3) var(--space-8)}
.brand em{font-style:normal;color:#ffb79e}
.brand span{font-size:var(--text-xs);font-weight:500;letter-spacing:.12em;color:#a9b9ca;margin-top:var(--space-3);line-height:1.5}
.nav-label{font-size:var(--text-xs);letter-spacing:.14em;color:#a8b8c8;margin:var(--space-4) var(--space-3) var(--space-2)}
.nav-button{min-height:44px;padding:var(--space-3);font-size:var(--text-sm);gap:var(--space-3);color:#c3cfdb;border-radius:7px;line-height:1.4}
.nav-button:hover{background:#ffffff0d;color:#fff}
.nav-button.active{background:#ebf3f9;color:#20334a;font-weight:700}
.nav-button.active .nav-icon{color:#ad442f}
.nav-icon{font-family:ui-monospace,monospace;width:22px;font-size:var(--text-xs);color:#92a6bb}
.nav-arrow{margin-left:auto;opacity:0}
.nav-button.active .nav-arrow{opacity:1;color:#ad442f}
.side-bottom{padding-top:var(--space-6)}
.side-quote{background:#253c53;border:0;padding:var(--space-4);border-radius:8px}
.side-quote .accent{color:#ffbd9e}.side-quote p{color:#bac9d7}
.side-quote .text-btn{color:#f1e6c8;padding-left:0}
.local-badge{color:#b0c0d0;font-size:var(--text-xs)}
.local-badge .dot{background:#add2aa}
.topbar{height:76px;padding:0 var(--space-8);background:var(--color-bg);border-bottom:1px solid var(--line)}
.breadcrumbs{font-size:var(--text-xs)}.breadcrumbs>b{font-weight:700}
.search-wrap{background:var(--surface);border-radius:8px;width:310px;padding:0 var(--space-3);border-color:var(--line)}
.search-wrap input{min-height:40px;font-size:var(--text-xs)}
.search-wrap>span:first-child{font-size:var(--text-lg)}
.avatar{background:#dfb2a0;color:#4a3025;border-radius:10px;font-weight:700}
.page{padding:var(--space-8);max-width:1560px;margin:auto}
.page-heading{padding-bottom:var(--space-5);border-bottom:1px solid var(--line);margin-bottom:var(--space-6)}
.page-heading h1{font-size:var(--text-xl)}.page-heading p{font-size:var(--text-sm)}
.btn{border-radius:7px;font-weight:700;padding:var(--space-3) var(--space-4);min-height:44px}
.btn.primary:hover{background:color-mix(in srgb,var(--accent) 90%,#000);filter:none}
.btn.outline{border-color:var(--line);background:var(--surface)}
.btn.outline:hover{background:var(--surface2)}
.btn.small{border-radius:6px}
.text-btn{font-weight:500;line-height:1.5;font-size:var(--text-xs)}
.text-btn:hover{text-decoration:underline;text-underline-offset:4px}
.icon-btn{border-radius:6px;min-width:44px;min-height:44px;font-size:var(--text-base)}
.icon-btn:hover{background:var(--surface2)}
.text-btn.danger,.icon-btn.danger{color:var(--danger)}
.panel{padding:var(--space-5);border:1px solid var(--line);background:var(--surface);border-radius:var(--radius-md);box-shadow:none}
.section-head{margin-bottom:var(--space-4)}.section-head h2{font-size:var(--text-lg)}
.eyebrow{font-size:var(--text-xs);letter-spacing:.12em;line-height:1.6;font-weight:700}
.mt-small{margin-top:var(--space-1)}
.desk-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--space-5);margin-bottom:var(--space-6)}
