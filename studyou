function profileField(...args){return field(...args).replaceAll('for="f-','for="profile-').replaceAll('id="f-','id="profile-')}
function field(
  label,
  name,
  value = "",
  type = "text",
  required = false,
  attrs = "",
  cls = "",
) {
  return `<div class="field ${cls}"><label for="f-${name}">${label}${required ? " *" : ""}</label><input id="f-${name}" name="${name}" type="${type}" value="${esc(value)}" ${required ? "required" : ""} ${attrs}></div>`;
}
function selectField(label, name, options, value = "", cls = "") {
  return `<div class="field ${cls}"><label for="f-${name}">${label}</label><select name="${name}" id="f-${name}">${options
    .map((o) => {
      const [v, l] = Array.isArray(o) ? o : [o, o];
      return `<option value="${esc(v)}" ${String(value) === String(v) ? "selected" : ""}>${esc(l)}</option>`;
    })
    .join("")}</select></div>`;
}
function textField(label, name, value = "", cls = "full") {
  return `<div class="field ${cls}"><label for="f-${name}">${label}</label><textarea id="f-${name}" name="${name}">${esc(value)}</textarea></div>`;
}
