  return `<div class="task-row ${st === "Completed" ? "done" : ""}" draggable="${full}" data-task-id="${esc(t.id)}"><label class="check-wrap"><input type="checkbox" data-action="toggle-task" data-id="${esc(t.id)}" ${st === "Completed" ? "checked" : ""} aria-label="Complete ${esc(t.title)}"></label><div class="grow"><div class="task-title">${esc(t.title)}</div><div class="task-meta"><span>${esc(subName(t.subject))}</span><span>·</span><span>${dateLabel(t.date)}${t.start ? " · " + esc(t.start) : ""}${t.end ? "–" + esc(t.end) : ""}</span>${full ? `<span>· ${esc(t.type || "Study")}</span>` : ""}</div></div><span class="chip ${esc((st === "Delayed" ? st : t.priority || "Medium").toLowerCase())}">${esc(st === "Delayed" ? st : t.priority || "Medium")}</span>${full ? `<div class="row gap8 task-actions"><button class="icon-btn" data-action="task-focus" data-id="${esc(t.id)}" aria-label="Focus on ${esc(t.title)}" title="Start focus">▷</button><button class="icon-btn" data-action="edit-task" data-id="${esc(t.id)}" aria-label="Edit task" title="Edit">⋯</button><button class="icon-btn" data-action="duplicate-task" data-id="${esc(t.id)}" aria-label="Duplicate task" title="Duplicate">⧉</button><button class="icon-btn danger" data-action="delete-task" data-id="${esc(t.id)}" aria-label="Delete task" title="Delete">×</button></div>` : ""}</div>`;
}
function timerPanel() {
