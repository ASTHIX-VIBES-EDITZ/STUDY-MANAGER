  return (
    (h ? h + ":" : "") +
    String(h ? Math.floor(n / 60) % 60 : Math.floor(n / 60)).padStart(2, "0") +
    ":" +
    String(n % 60).padStart(2, "0")
  );
}
function pauseTimer() {
